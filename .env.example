# Frontend: set when building Telegram or Minima. Leave empty for Solo / Training only.
VITE_MULTIPLAYER_WS_URL=wss://YOUR-FREE-SERVICE.onrender.com/ws

# Server: Render supplies PORT; local default is 3001.
PORT=3001
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174
RACE_TIMEOUT_SECONDS=240
MAX_ROOMS=32
# Native test clients only; keep false for a browser-only public deployment.
ALLOW_NO_ORIGIN=false
# Optional JSONL adapter. A Render Free local file is EPHEMERAL, not durable storage.
# RESULTS_FILE=/tmp/minimorph-results.jsonl
