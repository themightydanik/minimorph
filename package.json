{
  "name": "minimorph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:telegram": "npm run dev -w @minimorph/telegram",
    "dev:minima": "npm run dev -w @minimorph/minima",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "build": "npm run build --workspaces --if-present",
    "package:mds": "npm run build -w @minimorph/minima && node scripts/package-mds.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && node scripts/package-mds.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "eslint": "^9.39.0",
    "vite": "^7.2.2",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.56.1",
    "fflate": "^0.8.2",
    "globals": "^16.5.0"
  }
}
